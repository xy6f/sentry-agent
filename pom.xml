<?xml version="1.0" encoding="UTF-8"?>
<!--
  sentry-agent（AIOps 诊断自愈 Agent）—— 单模块工程（一个 src 直观好读）
  包结构即分层：graph(状态与图) / llm(模型网关:Prod 与 Mock) / tool(@Tool 与令牌护栏)
  / service(事件编排/Watchman) / controller(HTTP 外壳)
  框架分工（面试核心答案）：LangGraph4j 管拓扑/条件边/checkpoint 的"确定性"，
  LangChain4j 管模型调用/@Tool/AiServices 的"智能"。
  版本均为中央仓正式版：Boot 3.5.16 / LangChain4j 1.20.2 / LangGraph4j 1.9.3 / JDK 17。
  历史备注：曾拆为 agent-common/core/web 三模块，为可读性合回单模块；
  ApprovalRegistry 保持零 Spring 纯 POJO 由 LlmConfig @Bean 装配——这条分层纪律保留了下来。
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.5.16</version>
    <relativePath/>
  </parent>

  <groupId>com.sentryagent</groupId>
  <artifactId>sentry-agent</artifactId>
  <version>0.1.0</version>

  <properties>
    <java.version>17</java.version>
    <langchain4j.version>1.20.2</langchain4j.version>
    <langgraph4j.version>1.9.3</langgraph4j.version>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <!-- LangChain4j 核心：@Tool、AiServices、对话记忆 -->
    <dependency>
      <groupId>dev.langchain4j</groupId>
      <artifactId>langchain4j</artifactId>
      <version>${langchain4j.version}</version>
    </dependency>
    <!-- OpenAI 兼容 provider：换服务商只改配置 -->
    <dependency>
      <groupId>dev.langchain4j</groupId>
      <artifactId>langchain4j-open-ai</artifactId>
      <version>${langchain4j.version}</version>
    </dependency>
    <!-- LangGraph4j：状态图、条件边回环、checkpoint -->
    <dependency>
      <groupId>org.bsc.langgraph4j</groupId>
      <artifactId>langgraph4j-core</artifactId>
      <version>${langgraph4j.version}</version>
    </dependency>
    <dependency>
      <groupId>org.projectlombok</groupId>
      <artifactId>lombok</artifactId>
      <optional>true</optional>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
</project>
