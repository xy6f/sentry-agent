# 生产部署环境变量（docker-compose 用；勿提交真实值）
MYSQL_ROOT_PASSWORD=your-mysql-root-password
# LLM
SENTRY_LLM_ENABLED=false
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.deepseek.com/v1
# 通知（飞书 webhook 建法见 docs/DEPLOY.md 第 2 步）
SENTRY_NOTIFY_ENABLED=false
SENTRY_FEISHU_ENABLED=false
SENTRY_FEISHU_WEBHOOK=
SENTRY_WECOM_ENABLED=false
SENTRY_WECOM_WEBHOOK=
SENTRY_SMS_ENABLED=false
SENTRY_SMS_PHONES=
# Docker 真自愈（先读 docs/DEPLOY.md 第 5 节安全边界）
SENTRY_DOCKER_ENABLED=false
SENTRY_WATCHMAN_ENABLED=false
